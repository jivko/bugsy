<%= form_with model: user, class: "contents" do |form| %>
  <%= render "shared/error_messages", object: user %>

  <div class="my-5">
    <%= form.label :name, class: "block text-gray-700 font-medium" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :email_address, class: "block text-gray-700 font-medium" %>
    <%= form.email_field :email_address, required: true, autocomplete: "email", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <% if Current.user.admin? && user != Current.user %>
    <div class="my-5">
      <%= form.label :role, class: "block text-gray-700 font-medium" %>
      <%= form.select :role, User.roles.keys, {}, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  <% end %>

  <% if user.persisted? %>
    <hr class="my-6">
    <p class="text-sm text-gray-500 mb-4">Leave password blank to keep it unchanged.</p>
  <% end %>

  <div class="my-5">
    <%= form.label :password, (user.persisted? ? "New password" : "Password"), class: "block text-gray-700 font-medium" %>
    <%= form.password_field :password, required: user.new_record?, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :password_confirmation, class: "block text-gray-700 font-medium" %>
    <%= form.password_field :password_confirmation, required: user.new_record?, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="flex items-center gap-3 mt-6">
    <%= form.submit (user.persisted? ? "Save changes" : "Create user"), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <% if Current.user.admin? %>
      <%= link_to "Back to users", users_path, class: "text-gray-600 hover:text-gray-900" %>
    <% end %>
  </div>
<% end %>
