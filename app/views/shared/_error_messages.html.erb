<% if object.errors.any? %>
  <div class="bg-red-50 text-red-500 px-3 py-2 rounded-lg mt-3">
    <h2 class="font-medium"><%= pluralize(object.errors.count, "error") %> prohibited this record from being saved:</h2>
    <ul class="list-disc list-inside mt-1">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
