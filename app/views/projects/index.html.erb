<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Projects</h1>
    <%= link_to "New project", new_project_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @projects.any? %>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Members</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @projects.each do |project| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= link_to project.name, project, class: "hover:text-blue-600" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= project.owner.display_name %>
                <% if project.owner == Current.user %>
                  <span class="text-gray-400">(you)</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= project.members.size %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 space-x-3">
                <% if project.editable_by?(Current.user) %>
                  <%= link_to "Edit", edit_project_path(project), class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to "Members", project_members_path(project), class: "text-blue-600 hover:text-blue-900" %>
                  <%= button_to "Delete", project_path(project), method: :delete,
                      form: { onsubmit: "return confirm('Are you sure? This will delete all issues in this project.')" },
                      class: "text-red-600 hover:text-red-900 inline" %>
                <% else %>
                  <%= link_to "View", project, class: "text-blue-600 hover:text-blue-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-gray-50 rounded-lg">
      <p class="text-gray-500 mb-4">No projects yet.</p>
      <%= link_to "Create your first project", new_project_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
    </div>
  <% end %>
</div>
