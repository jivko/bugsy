<%= form_with model: project, class: "contents" do |form| %>
  <%= render "shared/error_messages", object: project %>

  <div class="my-5">
    <%= form.label :name, class: "block text-gray-700 font-medium" %>
    <%= form.text_field :name, required: true, autofocus: true, placeholder: "Project name", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :description, class: "block text-gray-700 font-medium" %>
    <%= form.text_area :description, rows: 3, placeholder: "Optional description", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="flex items-center gap-3 mt-6">
    <%= form.submit (project.persisted? ? "Save changes" : "Create project"), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancel", projects_path, class: "text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
