<div class="w-full max-w-2xl mx-auto">
  <div class="mb-6">
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
      <%= link_to @project.name, @project, class: "hover:text-gray-700" %>
      <span>/</span>
      <span>Members</span>
    </div>
    <h1 class="font-bold text-4xl">Project Members</h1>
  </div>

  <!-- Add member form -->
  <% if @available_users.any? %>
    <div class="bg-white shadow rounded-lg p-5 mb-6">
      <h2 class="font-semibold text-lg mb-4">Add member</h2>
      <%= form_with url: project_members_path(@project), method: :post, class: "flex gap-3" do |form| %>
        <div class="flex-1">
          <%= form.select :user_id, @available_users.map { |u| ["#{u.display_name} (#{u.email_address})", u.id] }, 
              { prompt: "Select user..." }, 
              required: true, 
              class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
        </div>
        <%= form.submit "Add", class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <% end %>
    </div>
  <% end %>

  <!-- Members list -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @memberships.each do |membership| %>
          <% member = membership.user %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
              <%= member.display_name %>
              <% if member == Current.user %>
                <span class="text-gray-400">(you)</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= member.email_address %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <% if member.id == @project.owner_id %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">Owner</span>
              <% else %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Member</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-right">
              <% if member.id != @project.owner_id %>
                <%= button_to "Remove", project_member_path(@project, membership), method: :delete,
                    form: { onsubmit: "return confirm('Remove #{member.display_name} from project?')" },
                    class: "text-red-600 hover:text-red-900" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6">
    <%= link_to "← Back to project", @project, class: "text-gray-600 hover:text-gray-900" %>
  </div>
</div>
